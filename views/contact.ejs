<%- include('partials/head') %>
<%- include('partials/header') %>

<main id="main" class="container py-4">
  <h2>Contact Me</h2>
  <p class="mb-4">Fill out the form below, and I will get back to you. All fields are required.</p>

  <!-- novalidate lets contact.js show custom messages; the HTML5 rules (required, type, pattern) still apply -->
  <form id="contact-form" class="contact-form card shadow-sm p-4" action="#" method="post" novalidate>
    <div class="mb-3">
      <label for="name" class="form-label fw-bold">Name</label>
      <input type="text" class="form-control" id="name" name="name" required minlength="2" maxlength="60"
             pattern="[A-Za-z][A-Za-z' \-]+" autocomplete="name" aria-describedby="name-error">
      <div class="invalid-feedback" id="name-error" role="alert"></div>
    </div>
    <div class="mb-3">
      <label for="email" class="form-label fw-bold">Email</label>
      <input type="email" class="form-control" id="email" name="email" required autocomplete="email"
             pattern="[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}" aria-describedby="email-error">
      <div class="invalid-feedback" id="email-error" role="alert"></div>
    </div>
    <div class="mb-3">
      <label for="phone" class="form-label fw-bold">Cell No.</label>
      <input type="tel" class="form-control" id="phone" name="phone" required placeholder="905-555-1234"
             pattern="\(?[0-9]{3}\)?[\- .]?[0-9]{3}[\- .]?[0-9]{4}" autocomplete="tel" aria-describedby="phone-error">
      <div class="invalid-feedback" id="phone-error" role="alert"></div>
    </div>
    <div class="mb-3">
      <label for="comments" class="form-label fw-bold">Comments</label>
      <textarea class="form-control" id="comments" name="comments" rows="5" required minlength="10" maxlength="500"
                aria-describedby="comments-error"></textarea>
      <div class="invalid-feedback" id="comments-error" role="alert"></div>
    </div>
    <button type="submit" class="btn btn-teal btn-lg"><i class="fa-solid fa-paper-plane me-2"></i>Submit</button>
    <p id="form-status" class="status fw-bold mt-3 mb-0" role="status"></p>
  </form>
</main>

<!-- This page's own script. It is in the "public/javascripts" folder. -->
<script src="/javascripts/contact.js"></script>
<%- include('partials/footer') %>
</body>
</html>
