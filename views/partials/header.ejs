<!-- Shared header: this partial is included at the top of every page -->
<header class="site-header">
  <nav class="navbar navbar-expand-md navbar-dark" aria-label="Main navigation">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/">Amin Al-Wagih</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
              aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="mainNav">
        <ul class="navbar-nav ms-auto">
          <!-- The link for the current page gets the "active" class and aria-current -->
          <li class="nav-item">
            <a class="nav-link <%= active === 'home' ? 'active' : '' %>" href="/"
               <%- active === 'home' ? 'aria-current="page"' : '' %>><i class="fa-solid fa-house me-1"></i>Home</a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= active === 'about' ? 'active' : '' %>" href="/about"
               <%- active === 'about' ? 'aria-current="page"' : '' %>><i class="fa-solid fa-user me-1"></i>About Me</a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= active === 'projects' ? 'active' : '' %>" href="/projects"
               <%- active === 'projects' ? 'aria-current="page"' : '' %>><i class="fa-solid fa-folder-open me-1"></i>Projects</a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= active === 'contact' ? 'active' : '' %>" href="/contact"
               <%- active === 'contact' ? 'aria-current="page"' : '' %>><i class="fa-solid fa-envelope me-1"></i>Contact Me</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>
</header>
