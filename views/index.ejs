<%- include('partials/head') %>
<%- include('partials/header') %>

<main id="main" class="container py-4">
  <!-- Hero banner: uses the angled gradient defined in style.css -->
  <section class="hero text-white rounded-3 p-4 p-md-5 mb-5">
    <h2 class="display-5 fw-bold">Hi, I'm Amin Al-Wagih</h2>
    <p class="lead">Technology Management (IT) student at Ontario Tech University building clean, accessible websites.</p>
    <a class="btn btn-teal btn-lg" href="/projects"><i class="fa-solid fa-arrow-right me-2"></i>View My Projects</a>
  </section>

  <section aria-labelledby="explore-heading">
    <h2 id="explore-heading" class="mb-4">Explore my portfolio</h2>
    <!-- Bootstrap grid: 1 column on phones, 3 columns from the medium breakpoint up -->
    <div class="row row-cols-1 row-cols-md-3 g-4">
      <div class="col">
        <article class="card h-100 shadow-sm">
          <div class="card-body">
            <h3 class="h5 card-title"><i class="fa-solid fa-user me-2 text-teal"></i>About Me</h3>
            <p class="card-text">Learn who I am and watch a short introduction video.</p>
            <a href="/about" class="stretched-link">Read more about me</a>
          </div>
        </article>
      </div>
      <div class="col">
        <article class="card h-100 shadow-sm">
          <div class="card-body">
            <h3 class="h5 card-title"><i class="fa-solid fa-folder-open me-2 text-teal"></i>Projects</h3>
            <p class="card-text">Five projects from my courses, from SAP simulations to graph theory and networking.</p>
            <a href="/projects" class="stretched-link">See my projects</a>
          </div>
        </article>
      </div>
      <div class="col">
        <article class="card h-100 shadow-sm">
          <div class="card-body">
            <h3 class="h5 card-title"><i class="fa-solid fa-envelope me-2 text-teal"></i>Contact Me</h3>
            <p class="card-text">Have a question or an opportunity? Send me a message.</p>
            <a href="/contact" class="stretched-link">Get in touch</a>
          </div>
        </article>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
</body>
</html>
