<%- include('partials/head') %>
<%- include('partials/header') %>

<main id="main" class="container py-4">
  <h1 class="h2 mb-4">About Me</h1>

  <article class="row g-4 align-items-center mb-5">
    <figure class="col-12 col-md-4 text-center mb-0">
      <img src="/images/profile.jpg" class="img-fluid rounded-3 shadow-sm"
           alt="Amin Al-Wagih in a blue blazer and white shirt, looking out of a car window"
           width="400" height="400">
      <figcaption class="mt-2 fst-italic">Amin Al-Wagih</figcaption>
    </figure>
    <div class="col-12 col-md-8">
      <h3>Hello!</h3>
      <p>My name is Amin. I am a Technology Management (IT) student at Ontario Tech University, and my roots are in Yemen and Ethiopia. Outside of class I love playing soccer, playing video games, and hanging out with friends.</p>
      <p>After graduating, I plan to find a good job in IT and build a family of my own. This portfolio shows some of the work I have done along the way.</p>
    </div>
  </article>

  <section aria-labelledby="video-heading" class="text-center">
    <h3 id="video-heading" class="mb-3"><i class="fa-solid fa-circle-play me-2 text-teal"></i>Watch my introduction</h3>
    <!-- HTML5 video: "controls" shows the player buttons and "poster" is the preview image -->
    <video controls poster="/images/poster.jpg" preload="metadata" class="intro-video">
      <source src="/media/intro.mp4" type="video/mp4">
      <p>Your browser does not support HTML5 video. <a href="/media/intro.mp4">Download the video</a> instead.</p>
    </video>
  </section>
</main>

<%- include('partials/footer') %>
</body>
</html>
